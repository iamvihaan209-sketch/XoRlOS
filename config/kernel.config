# XoRlOS kernel config fragment (Linux 6.x), merge over defconfig.
# Targets a lightweight desktop: 1 GB RAM minimum.

CONFIG_LOCALVERSION="-xorlos"
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y
CONFIG_SMP=y

# Memory
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y

# Graphics (X11)
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_VESA=y

# Input, USB, networking
CONFIG_INPUT_EVDEV=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_STORAGE=y
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
