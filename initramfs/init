#!/bin/sh
# XoRlOS live-boot init. Runs as PID 1 inside the initramfs.
#
# 1. load storage / filesystem modules
# 2. find the boot media (the ISO) that contains rootfs.squashfs
# 3. mount the squashfs read-only and put a tmpfs overlay on top
# 4. move the pseudo-filesystems across and switch_root into the real system
#
# Kernel command line flags:
#   xorlos.shell   drop to a shell instead of booting (debugging)

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ISO=/mnt/iso
RO=/mnt/ro
RW=/mnt/rw
NEW=/mnt/new

say() { echo "xorlos-init: $*"; }

# The initramfs only links a few BusyBox applets by default; link them all
# (sleep, setsid, cttyhack, ...).
if [ -x /bin/busybox ]; then
    /bin/busybox --install -s 2>/dev/null
fi

rescue() {
    say "$*"
    say "dropping to a rescue shell"
    if command -v cttyhack >/dev/null 2>&1; then
        exec setsid cttyhack /bin/sh
    fi
    exec /bin/sh
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /mnt/iso /mnt/ro /mnt/rw /mnt/new

say "starting live boot"

case " $(cat /proc/cmdline) " in
    *" xorlos.shell "*) rescue "xorlos.shell requested" ;;
esac

# Storage, CD/USB and filesystem drivers. Missing ones are fine (built in, or
# not needed on this machine), so errors are ignored.
for m in loop squashfs overlay isofs vfat nls_utf8 nls_cp437 nls_iso8859-1 \
         scsi_mod cdrom sr_mod sd_mod sg \
         libata ata_piix ata_generic pata_acpi ahci \
         virtio virtio_pci virtio_blk virtio_scsi \
         vmw_pvscsi mptbase mptscsih mptspi BusLogic \
         nvme usb_storage uas ehci_pci xhci_pci uhci_hcd ohci_pci; do
    modprobe -q "$m" 2>/dev/null
done

find_media() {
    for dev in /dev/sr[0-9]* /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/vd[a-z] \
               /dev/vd[a-z][0-9]* /dev/nvme[0-9]*n[0-9]* ; do
        [ -b "$dev" ] || continue
        for fs in iso9660 vfat ext4; do
            if mount -t "$fs" -o ro "$dev" "$ISO" 2>/dev/null; then
                if [ -f "$ISO/rootfs.squashfs" ]; then
                    say "found boot media on $dev ($fs)"
                    return 0
                fi
                umount "$ISO"
            fi
        done
    done
    return 1
}

tries=0
until find_media; do
    tries=$((tries + 1))
    [ "$tries" -ge 40 ] && rescue "could not find boot media containing rootfs.squashfs"
    sleep 1
done

mount -t squashfs -o loop,ro "$ISO/rootfs.squashfs" "$RO" ||
    rescue "failed to mount rootfs.squashfs"

mount -t tmpfs -o mode=755 tmpfs "$RW" || rescue "failed to mount tmpfs"
mkdir -p "$RW/upper" "$RW/work"

mount -t overlay overlay \
    -o "lowerdir=$RO,upperdir=$RW/upper,workdir=$RW/work" "$NEW" ||
    rescue "failed to mount overlay root"

# Keep the live media mounted (the squashfs needs it) inside the new root.
mkdir -p "$NEW/.live/iso" "$NEW/.live/ro" "$NEW/.live/rw"
mount --move "$ISO" "$NEW/.live/iso"
mount --move "$RO" "$NEW/.live/ro"
mount --move "$RW" "$NEW/.live/rw"

mount --move /dev "$NEW/dev"
mount --move /sys "$NEW/sys"
mount --move /proc "$NEW/proc"

say "root mounted, handing over to /sbin/init"
exec switch_root "$NEW" /sbin/init || rescue "switch_root failed"
